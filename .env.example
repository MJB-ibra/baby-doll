# ================= SERVER =================
PORT=3230
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ================= MYSQL =================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=baby_doll

# ================= AUTH =================
# Generate a long random value. NEVER commit .env.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ================= PAYMENT WEBHOOK =================
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
DELIVERY_CODE_SECRET=CHANGE_ME_TO_A_THIRD_LONG_RANDOM_SECRET

# ================= MTN MOMO RW =================
# Sandbox example. Use the exact base URL supplied by your MTN Rwanda account.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.co.rw
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# ================= AIRTEL MONEY RW =================
# Airtel provisions the application credentials/base URL.
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# ================= MTN SMS =================
# SMS v3 is available in Rwanda. MTN supplies the endpoint/credentials
# after app registration.
SMS_PROVIDER=console
MTN_SMS_TOKEN_URL=https://api.mtn.com/oauth/client_credential/accesstoken
MTN_SMS_SEND_URL=
MTN_SMS_CLIENT_ID=
MTN_SMS_CLIENT_SECRET=
MTN_SMS_SUBSCRIPTION_KEY=
MTN_SMS_SENDER=

# ================= CARD CHECKOUT =================
# Do not put card number/CVV handling in this Express app.
# Configure a PCI-compliant hosted checkout/acquirer that supports
# Mastercard/Visa and 3-D Secure.
CARD_CHECKOUT_URL=

# ================= FRONTEND PAYMENT RETURN =================
PAYMENT_RETURN_URL=http://localhost:5173/payment/result
